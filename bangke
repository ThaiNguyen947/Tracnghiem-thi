            const dropdown = document.getElementById('streetDropdown');
            if (!dropdown.classList.contains('hidden')) {
                dropdown.classList.add('hidden');
            } else {
                renderStreetList(currentWardStreets);
            }
        }

        function filterStreets() {
            const keyword = document.getElementById('streetSearchInput').value.toLowerCase().trim();
            const filtered = currentWardStreets.filter(item => {
                let text = item.from === "TRỌN ĐƯỜNG" 
                    ? `Đường ${item.street} (Trọn đường)` 
                    : `Đường ${item.street} (từ ${item.from} đến ${item.to})`;
                return text.toLowerCase().includes(keyword);
            });
            renderStreetList(filtered);
        }

        function renderStreetList(list) {
            const dropdown = document.getElementById('streetDropdown');
            dropdown.innerHTML = '';
            if (list.length > 0) {
                dropdown.classList.remove('hidden');
                list.forEach(item => {
                    let segmentText = item.from === "TRỌN ĐƯỜNG" 
                        ? "(Trọn đường)" 
                        : `(từ ${item.from} đến ${item.to})`;
                    
                    let div = document.createElement('div');
                    div.className = "p-2.5 hover:bg-blue-50 cursor-pointer text-sm border-b last:border-b-0 flex justify-between items-center";
                    
                    let realDisplayPrice = item.price * 1000;

                    div.innerHTML = `
                        <div>
                            <span class="font-bold text-slate-800">Đường ${item.street}</span> 
                            <span class="text-xs font-semibold text-purple-600 ml-1">${segmentText}</span>
                        </div>
                        <span class="text-xs font-bold text-red-600 bg-red-50 px-2 py-0.5 rounded">${realDisplayPrice.toLocaleString('vi-VN')} đ</span>
                    `;

                    div.onclick = function() {
                        let fullText = `Đường ${item.street} ${segmentText}`;
                        document.getElementById('streetSearchInput').value = fullText;
                        dropdown.classList.add('hidden');

                        const firstTcRow = document.querySelector('#quick-tc-container .tc-row');
                        if (firstTcRow) {
                            const priceInput = firstTcRow.querySelector('.tc-price');
                            const posSelect = firstTcRow.querySelector('.tc-pos');
                            if (priceInput) priceInput.value = realDisplayPrice.toLocaleString('vi-VN') + ' đ';
                            if (posSelect) posSelect.value = "1";
                        }
                        calculateAll();
                    };
                    dropdown.appendChild(div);
                });
            } else {
                let div = document.createElement('div');
                div.className = "p-2.5 text-xs text-slate-400 text-center";
                div.textContent = "Không có dữ liệu đường cho phường này (hoặc chưa chọn phường)";
                dropdown.appendChild(div);
                dropdown.classList.remove('hidden');
            }
        }

        function addQuickAgriRow() {
            const container = document.getElementById('quick-agri-container');
            const div = document.createElement('div');
            div.className = "flex gap-1 items-center bg-white border rounded-xl p-1 focus-within:ring-2 focus-within:ring-blue-500 relative agri-row";
            div.innerHTML = `
                <select class="w-16 p-1 bg-slate-50 border rounded-lg font-bold text-amber-700 text-xs outline-none agri-type" onchange="calculateAll()">
                    <option value="CLN">CLN</option>
                    <option value="HNK">HNK</option>
                </select>
                <input type="number" placeholder="m²..." class="w-20 p-1.5 bg-transparent text-sm outline-none agri-area" oninput="calculateAll()">
                <select class="w-16 p-1 bg-slate-50 border rounded-lg font-semibold text-blue-600 text-xs outline-none agri-pos" onchange="calculateAll()">
                    <option value="1">VT 1</option><option value="2">VT 2</option><option value="3">VT 3</option><option value="4">VT 4</option>
                </select>
                <button type="button" onclick="this.closest('div').remove(); calculateAll();" class="text-red-500 font-bold px-1 text-xs hover:text-red-700">✕</button>
            `;
            container.appendChild(div);
            calculateAll();
        }

        function addQuickTcRow() {
            let currentStreetPriceVal = "";
            const firstRow = document.querySelector('#quick-tc-container .tc-row');
            if (firstRow) {
                currentStreetPriceVal = firstRow.querySelector('.tc-price').value;
            }

            const container = document.getElementById('quick-tc-container');
            const div = document.createElement('div');
            div.className = "flex gap-1 items-center bg-white border rounded-xl p-1 focus-within:ring-2 focus-within:ring-emerald-500 relative tc-row";
            div.innerHTML = `
                <span class="w-10 p-1 bg-slate-50 border rounded-lg font-bold text-emerald-700 text-xs text-center">TC</span>
                <input type="text" placeholder="Chưa chọn đường" value="${currentStreetPriceVal}" readonly class="w-28 p-1.5 bg-slate-100 border rounded-lg text-xs font-semibold text-blue-700 outline-none cursor-not-allowed tc-price">
                <input type="number" placeholder="m²..." class="w-16 p-1.5 bg-transparent text-sm outline-none tc-area" oninput="calculateAll()">
                <select class="w-14 p-1 bg-slate-50 border rounded-lg font-semibold text-emerald-600 text-xs outline-none tc-pos" onchange="calculateAll()">
                    <option value="1">VT 1</option><option value="2">VT 2</option><option value="3">VT 3</option><option value="4">VT 4</option>
                </select>
                <button type="button" onclick="this.closest('div').remove(); calculateAll();" class="text-red-500 font-bold px-1 text-xs hover:text-red-700">✕</button>
            `;
            container.appendChild(div);
            calculateAll();
        }

        function formatMoneyInput(input) {
            let val = input.value.replace(/\D/g, '');
            if (val) input.value = Number(val).toLocaleString('vi-VN') + ' đ';
        }

        function unformatMoneyInput(input) {
            let val = input.value.replace(/\D/g, '');
            input.value = val ? val : '';
        }

        function parseMoney(valStr) {
            if (!valStr) return 0;
            let clean = valStr.toString().replace(/\D/g, '');
            return clean ? parseFloat(clean) : 0;
        }

        function calculateAll() {
            let totalLandMoney = 0;
            let zone = document.getElementById('commonZone').value || "Khu vực 4";
            
            let detailHtml = '';
            let hasInputData = false;

            document.querySelectorAll('#quick-tc-container .tc-row').forEach(row => {
                let basePrice1 = parseMoney(row.querySelector('.tc-price').value) * 1000; 
                let area = parseFloat(row.querySelector('.tc-area').value) || 0;
                let pos = row.querySelector('.tc-pos').value;

                let multiplier = 1;
                if (pos === "2") {
                    multiplier = 0.5;
                } else if (pos === "3") {
                    multiplier = 0.5 * 0.8;
                } else if (pos === "4") {
                    multiplier = 0.5 * 0.8 * 0.8;
                }

                let actualPrice = basePrice1 * multiplier;

                if (area > 0 && basePrice1 > 0) {
                    hasInputData = true;
                    let lineTotal = actualPrice * area;
                    totalLandMoney += lineTotal;

                    detailHtml += `
                        <tr class="border-b hover:bg-slate-50">
                            <td class="p-2.5 font-bold text-emerald-700">TC</td>
                            <td class="p-2.5 text-slate-600">Vị trí ${pos}</td>
                            <td class="p-2.5 font-semibold text-blue-600">${Math.round(actualPrice).toLocaleString('vi-VN')} đ</td>
                            <td class="p-2.5 text-slate-700">${area.toLocaleString('vi-VN')} m²</td>
                            <td class="p-2.5 text-right font-bold text-slate-800">${Math.round(lineTotal).toLocaleString('vi-VN')} đ</td>
                        </tr>
                    `;
                }
            });

            document.querySelectorAll('#quick-agri-container .agri-row').forEach(row => {
                let type = row.querySelector('.agri-type').value;
                let areaInput = row.querySelector('.agri-area');
                let area = parseFloat(areaInput.value) || 0;
                let pos = row.querySelector('.agri-pos').value;
                
                if (area > 0) {
                    hasInputData = true;
                    let price = (agriPriceTable[type] && agriPriceTable[type][zone] && agriPriceTable[type][zone][pos]) ? agriPriceTable[type][zone][pos] : 0;
                    let lineTotal = price * area;
                    totalLandMoney += lineTotal;

                    detailHtml += `
                        <tr class="border-b hover:bg-slate-50">
                            <td class="p-2.5 font-bold text-amber-700">${type}</td>
                            <td class="p-2.5 text-slate-600">Vị trí ${pos}</td>
                            <td class="p-2.5 font-semibold text-blue-600">${price.toLocaleString('vi-VN')} đ</td>
                            <td class="p-2.5 text-slate-700">${area.toLocaleString('vi-VN')} m²</td>
                            <td class="p-2.5 text-right font-bold text-slate-800">${lineTotal > 0 ? lineTotal.toLocaleString('vi-VN') + ' đ' : '0 đ'}</td>
                        </tr>
                    `;
                }
            });

            const detailSection = document.getElementById('detailSection');
            const summaryCol = document.getElementById('summaryColumn');

            if (hasInputData) {
                detailSection.classList.remove('hidden');
                summaryCol.className = "lg:col-span-1 space-y-4 transition-all";
            } else {
                detailSection.classList.add('hidden');
                summaryCol.className = "lg:col-span-3 space-y-4 transition-all";
            }

            document.getElementById('detailTableBody').innerHTML = detailHtml;

            let contractVal = parseMoney(document.getElementById('contractValue').value);
            let otherAsset = parseMoney(document.getElementById('otherAssetValue').value);
            let baseValue = contractVal > 0 ? contractVal : (totalLandMoney + otherAsset);

            let notaryFee = 0;
            if (baseValue > 0) {
                if (baseValue <= 50000000) { notaryFee = 50000; } 
                else if (baseValue <= 100000000) { notaryFee = 100000; } 
                else if (baseValue <= 1000000000) { notaryFee = 100000 + (baseValue - 100000000) * 0.001; } 
                else if (baseValue <= 3000000000) { notaryFee = 1000000 + (baseValue - 1000000000) * 0.0008; } 
                else if (baseValue <= 5000000000) { notaryFee = 2600000 + (baseValue - 3000000000) * 0.0006; } 
                else if (baseValue <= 10000000000) { notaryFee = 3800000 + (baseValue - 5000000000) * 0.0004; } 
                else if (baseValue <= 100000000000) { notaryFee = 5800000 + (baseValue - 10000000000) * 0.0002; } 
                else { notaryFee = 23800000 + (baseValue - 100000000000) * 0.0001; }
            }

            let serviceFee = Math.round(baseValue * 0.0005);
            let otherCost = parseMoney(document.getElementById('otherCost').value);
            let grandTotal = notaryFee + serviceFee + otherCost;

            document.getElementById('resNotaryFee').textContent = Math.round(notaryFee).toLocaleString('vi-VN') + ' đ';
            document.getElementById('resServiceFee').textContent = Math.round(serviceFee).toLocaleString('vi-VN') + ' đ';
            document.getElementById('resTotal').textContent = Math.round(grandTotal).toLocaleString('vi-VN') + ' đ';
        }

        function resetAllForm() {
            document.querySelectorAll('input').forEach(input => {
                if(input.type === 'text' || input.type === 'number') input.value = '';
            });
            document.getElementById('contractTypeVal').value = '';
            document.getElementById('jsonWardSelect').value = '';
            document.getElementById('commonZone').value = 'Khu vực 4';
            document.getElementById('displayZoneTag').textContent = 'Khu vực 4';
            document.getElementById('streetSearchInput').value = '';
            currentWardStreets = [];
            calculateAll();
        }
    </script>
</body>
</html>
