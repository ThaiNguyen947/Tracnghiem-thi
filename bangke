<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Bảng Kê Tính Phí Công Chứng & Tra Cứu Giá Đất</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-100 min-h-screen py-6 px-4">
    <div class="max-w-7xl mx-auto bg-white rounded-2xl shadow-xl p-5 md:p-8">
        <h1 class="text-2xl font-bold text-slate-800 text-center mb-6">📝 BẢNG KÊ TÍNH PHÍ CÔNG CHỨNG & TRA CỨU GIÁ ĐẤT</h1>
        
        <!-- KHUNG THÔNG TIN CHUNG -->
        <div class="bg-slate-50 p-5 rounded-xl border mb-6 space-y-4">
          
          <!-- Hàng 1: Loại hợp đồng, Tên công chứng viên -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 pb-4 border-b">
              <div class="relative">
                  <label class="block font-bold text-slate-700 text-xs mb-1">Loại hợp đồng (Dữ liệu DSHD):</label>
                  <div class="relative">
                      <input type="text" id="contractSearchInput" placeholder="-- Chọn hoặc gõ tìm loại hợp đồng --" class="w-full p-2.5 pr-8 border rounded-xl bg-white font-semibold text-sm text-blue-700 focus:ring-2 focus:ring-blue-500 outline-none cursor-pointer" autocomplete="off" oninput="filterContracts()" onclick="toggleContractDropdown(event)">
                      <span class="absolute right-3 top-3 text-slate-400 pointer-events-none text-xs">▼</span>
                  </div>
                  <input type="hidden" id="contractTypeVal">
                  <div id="contractDropdown" class="absolute z-50 left-0 right-0 mt-1 bg-white border rounded-xl shadow-lg max-h-60 overflow-y-auto hidden"></div>
              </div>

              <div>
                  <label class="block font-bold text-slate-700 text-xs mb-1">Tên người công chứng:</label>
                  <input type="text" id="notaryName" placeholder="Nhập tên..." class="w-full p-2.5 border rounded-xl bg-white text-sm focus:ring-2 focus:ring-blue-500 outline-none">
              </div>
          </div>

          <!-- Hàng 2: Chọn Xã/Phường và Tra cứu đường -->
          <div class="bg-white p-4 rounded-xl border shadow-sm grid grid-cols-1 md:grid-cols-2 gap-4 items-center">
              <div class="relative">
                  <label class="block font-bold text-slate-700 text-xs mb-1.5">ĐẤT TẠI PHƯỜNG / XÃ (Dữ liệu KV1 - KV4):</label>
                  <div class="relative">
                      <input type="text" id="wardSearchInput" placeholder="-- Chọn hoặc gõ tên Phường / Xã --" class="w-full p-2.5 pr-8 border rounded-xl bg-white font-semibold text-sm text-blue-700 focus:ring-2 focus:ring-blue-500 outline-none cursor-pointer" autocomplete="off" oninput="filterWards()" onclick="toggleWardDropdown(event)">
                      <span class="absolute right-3 top-3 text-slate-400 pointer-events-none text-xs">▼</span>
                  </div>
                  <input type="hidden" id="jsonWardSelect">
                  <div id="wardDropdown" class="absolute z-50 left-0 right-0 mt-1 bg-white border rounded-xl shadow-lg max-h-60 overflow-y-auto hidden"></div>
              </div>

              <div class="relative">
                  <label class="block font-bold text-slate-700 text-xs mb-1.5">TRA CỨU ĐƯỜNG THEO PHƯỜNG / XÃ:</label>
                  <div class="relative">
                      <input type="text" id="streetSearchInput" placeholder="Chọn phường trước, sau đó gõ/chọn đường..." class="w-full p-2.5 pr-8 border rounded-xl bg-white font-semibold text-sm text-red-600 focus:ring-2 focus:ring-blue-500 outline-none cursor-pointer" autocomplete="off" oninput="filterStreets()" onclick="toggleStreetDropdown(event)">
                      <span class="absolute right-3 top-3 text-slate-400 pointer-events-none text-xs">▼</span>
                  </div>
                  <div id="streetDropdown" class="absolute z-50 left-0 right-0 mt-1 bg-white border rounded-xl shadow-lg max-h-60 overflow-y-auto hidden"></div>
              </div>
          </div>

          <!-- Các khối nhập liệu nhanh -->
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 pt-1">
              
              <!-- Khối CLN / HNK -->
              <div class="flex flex-col gap-1">
                  <div class="flex justify-between items-center">
                      <label class="font-bold text-slate-700 text-xs">Diện tích CLN / HNK:</label>
                      <button onclick="addQuickAgriRow()" type="button" class="bg-blue-600 hover:bg-blue-700 text-white font-bold px-1.5 py-0.5 rounded text-xs transition shadow">➕ Thêm VT</button>
                  </div>
                  <div id="quick-agri-container" class="space-y-1.5">
                      <div class="flex gap-1 items-center bg-white border rounded-xl p-1 focus-within:ring-2 focus-within:ring-blue-500 agri-row">
                          <select class="w-16 p-1 bg-slate-50 border rounded-lg font-bold text-amber-700 text-xs outline-none agri-type" onchange="calculateAll()">
                              <option value="CLN">CLN</option>
                              <option value="HNK">HNK</option>
                          </select>
                          <input type="number" placeholder="m²..." class="w-20 p-1.5 bg-transparent text-sm outline-none agri-area" oninput="calculateAll()">
                          <select class="w-16 p-1 bg-slate-50 border rounded-lg font-semibold text-blue-600 text-xs outline-none agri-pos" onchange="calculateAll()">
                              <option value="1">VT 1</option>
                              <option value="2">VT 2</option>
                              <option value="3">VT 3</option>
                              <option value="4">VT 4</option>
                          </select>
                      </div>
                  </div>
              </div>

              <!-- Khối Thổ Cư (TC) - Đơn giá cố định theo đường, readonly -->
              <div class="flex flex-col gap-1">
                  <div class="flex justify-between items-center">
                      <label class="font-bold text-slate-700 text-xs">Diện tích Thổ Cư (TC):</label>
                      <button onclick="addQuickTcRow()" type="button" class="bg-emerald-600 hover:bg-emerald-700 text-white font-bold px-1.5 py-0.5 rounded text-xs transition shadow">➕ Thêm VT</button>
                  </div>
                  <div id="quick-tc-container" class="space-y-1.5">
                      <div class="flex gap-1 items-center bg-white border rounded-xl p-1 focus-within:ring-2 focus-within:ring-emerald-500 tc-row">
                          <span class="w-10 p-1 bg-slate-50 border rounded-lg font-bold text-emerald-700 text-xs text-center">TC</span>
                          <input type="text" placeholder="Chưa chọn đường" readonly class="w-28 p-1.5 bg-slate-100 border rounded-lg text-xs font-semibold text-blue-700 outline-none cursor-not-allowed tc-price">
                          <input type="number" placeholder="m²..." class="w-16 p-1.5 bg-transparent text-sm outline-none tc-area" oninput="calculateAll()">
                          <select class="w-14 p-1 bg-slate-50 border rounded-lg font-semibold text-emerald-600 text-xs outline-none tc-pos" onchange="calculateAll()">
                              <option value="1">VT 1</option>
                              <option value="2">VT 2</option>
                              <option value="3">VT 3</option>
                              <option value="4">VT 4</option>
                          </select>
                      </div>
                  </div>
              </div>

              <div class="flex flex-col gap-1">
                  <label class="font-bold text-slate-700 text-xs">Giá trị trên HĐ:</label>
                  <input type="text" id="contractValue" placeholder="0 đ" class="w-full p-2.5 bg-white border rounded-xl font-semibold text-blue-700 text-sm focus:ring-2 focus:ring-blue-500 outline-none" onfocus="unformatMoneyInput(this)" onblur="formatMoneyInput(this)" oninput="calculateAll()">
              </div>

              <div class="flex flex-col gap-1">
                  <label class="font-bold text-red-600 text-xs">Tiền khác (giá trị ts...):</label>
                  <input type="text" id="otherAssetValue" placeholder="0 đ" class="w-full p-2.5 bg-white border rounded-xl font-bold text-red-600 text-sm focus:ring-2 focus:ring-blue-500 outline-none" onfocus="unformatMoneyInput(this)" onblur="formatMoneyInput(this)" oninput="calculateAll()">
              </div>
          </div>

          <div class="flex justify-end gap-3 pt-2">
              <button onclick="calculateAll()" class="bg-blue-600 hover:bg-blue-700 text-white font-bold px-5 py-2.5 rounded-xl shadow text-sm transition">🧮 Tính Toán</button>
              <button onclick="resetAllForm()" class="bg-slate-500 hover:bg-slate-600 text-white font-bold px-5 py-2.5 rounded-xl shadow text-sm transition">🔄 Xóa Trắng Tất Cả</button>
          </div>
        </div>

        <!-- BẢNG CHI TIẾT HIỂN THỊ THÔNG TIN ĐẤT & TỔNG KẾT -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            
            <!-- CỘT TRÁI: Bảng chi tiết tổng hợp (Thổ cư & Nông nghiệp) -->
            <div id="detailSection" class="lg:col-span-2 space-y-4 hidden">
                <div class="bg-white border rounded-2xl shadow-sm overflow-hidden">
                    <div class="bg-amber-500 text-white font-bold px-4 py-3 text-sm flex justify-between items-center">
                        <span>📋 BẢNG GIÁ ĐẤT CHI TIẾT (THỔ CƯ & NÔNG NGHIỆP)</span>
                        <span id="displayZoneTag" class="bg-white text-amber-800 text-xs px-2.5 py-1 rounded-lg">Khu vực 4</span>
                    </div>
                    <div class="p-4 overflow-x-auto">
                        <table class="w-full text-left border-collapse text-sm">
                            <thead>
                                <tr class="border-b text-slate-600 text-xs bg-slate-50">
                                    <th class="p-2.5">Loại Đất</th>
                                    <th class="p-2.5">Vị trí</th>
                                    <th class="p-2.5">Đơn giá quy định</th>
                                    <th class="p-2.5">Diện tích nhập</th>
                                    <th class="p-2.5 text-right">Thành tiền</th>
                                </tr>
                            </thead>
                            <tbody id="detailTableBody">
                                <!-- Dữ liệu dòng chi tiết sẽ tự sinh ra ở đây -->
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="hidden">
                    <input type="text" id="commonArea" readonly>
                    <input type="text" id="commonZone" value="Khu vực 4" readonly>
                </div>
            </div>

            <!-- CỘT PHẢI: Bảng tổng kết chi phí -->
            <div id="summaryColumn" class="lg:col-span-3 space-y-4 transition-all">
                <div class="border-2 border-slate-300 rounded-2xl p-5 bg-slate-50 shadow-md max-w-xl mx-auto lg:max-w-none">
                    <h2 class="font-bold text-slate-700 text-center mb-4 pb-2 border-b text-sm">📊 Tổng Hợp Chi Phí</h2>
                    
                    <div class="space-y-3 text-sm">
                        <div class="flex justify-between items-center bg-white p-2.5 border rounded-xl">
                            <span class="font-medium text-slate-600 text-xs">Phí công chứng:</span>
                            <span id="resNotaryFee" class="font-bold text-slate-800 text-sm">0 đ</span>
                        </div>
                        <div class="flex justify-between items-center bg-white p-2.5 border rounded-xl">
                            <span class="font-medium text-slate-600 text-xs">Giá dịch vụ công chứng:</span>
                            <span id="resServiceFee" class="font-bold text-slate-800 text-sm">0 đ</span>
                        </div>
                        <div class="flex justify-between items-center bg-white p-2.5 border rounded-xl">
                            <span class="font-medium text-slate-600 text-xs">Chi phí khác (Photo,...):</span>
                            <input type="text" id="otherCost" placeholder="0 đ" class="w-28 p-1.5 border rounded-lg text-right font-bold text-slate-800 text-sm outline-none focus:ring-2 focus:ring-blue-500" onfocus="unformatMoneyInput(this)" onblur="formatMoneyInput(this)" oninput="calculateAll()">
                        </div>
                        <div class="flex justify-between items-center bg-red-50 border-2 border-red-300 p-3.5 rounded-xl">
                            <span class="font-bold text-red-700 text-xs">Tổng tiền công chứng là:</span>
                            <span id="resTotal" class="font-extrabold text-red-600 text-base">0 đ</span>
                        </div>
                    </div>

                    <div class="mt-6 flex gap-3">
                        <button onclick="alert('Đã xuất phiếu thành công!')" class="flex-1 bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-3 px-4 rounded-xl shadow transition flex items-center justify-center gap-2 text-sm">
                            <span>➡️ Xuất Phiếu</span>
                        </button>
                        <button onclick="window.print()" class="bg-slate-600 hover:bg-slate-700 text-white font-bold py-2.5 px-4 rounded-xl text-xs transition">
                            🖨️ In / PDF
                        </button>
                    </div>
                </div>
            </div>

        </div>
    </div>

